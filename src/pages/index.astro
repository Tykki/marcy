                </div>
              </div>
              <div class="col-lg-8">
                <div class="post-list">
                  {culture[3] &&
                    <a href={culture[3].href}><Image src={culture[3].img} height="571" width="900" alt="photo" class="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{culture[3].cate}</span> <span class="mx-1">•</span> <span>{culture[3].date}</span></div>
