---
import MainLayout from "../layouts/MainLayout.astro";
import {Image} from "astro:assets"
import BlogImg from '../components/BlogImg.astro'
import Slider from '../components/Slider.astro'
import avi from "../assets/img/person-1.jpg"
import avi2 from '../assets/img/person-2.jpg'
import avi3 from '../assets/img/person-4.jpg'
import avi4 from '../assets/img/person-7.jpg'
import {featured, trend, culture} from '../consts'

  
---

<MainLayout title="Marcy | Home" description="Home of Blog Page" page="index-page">
    <!-- Slider Section -->
    <section id="slider" class="slider section dark-background">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <Slider featured={featured} />

      </div>

    </section><!-- /Slider Section -->

    <!-- Trending Category Section -->
    <section id="trending-category" class="trending-category section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="container" data-aos="fade-up">
          <div class="row g-5">
            <div class="col-lg-4">

              <div class="post-entry lg">
                {trend[0] && 
                  <a href={trend[0].href}><BlogImg src={trend[0].img} alt="image about Post" c="img-fluid" /></a>
                  <div class="post-meta"><span class="date">{trend[0]}.cate</span> <span class="mx-1">•</span> <span>{trend[0].date}</span></div>
                  <h2><a href={trend[0].href}>{trend[0].title}</a></h2>
                  <p class="mb-4 d-block">{trend[0].preview}</p>

                  <div class="d-flex align-items-center author">
                    <div class="photo"><Image src={avi} alt="" class="img-fluid" /></div>
                    <div class="name">
                      <h3 class="m-0 p-0">Marcy</h3>
                    </div>
                  </div>
                }
              </div>

            </div>

            <div class="col-lg-8">
              <div class="row g-5">
                <div class="col-lg-4 border-start custom-border">
                  {trend.slice(1, 4).map(post => (
                  <div class="post-entry">
                    <a href={post.href}><BlogImg src={post.img} alt="info about Post" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                    <h2><a href={post.href}>{post.title}</a></h2>
                  </div>
                  ))}
                </div>
                <div class="col-lg-4 border-start custom-border">
                  {trend.slice(4, 7).map(post => (
                  <div class="post-entry">
                    <a href={post.href}><BlogImg src={post.img} alt="info about Post" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                    <h2><a href={post.href}>{post.title}</a></h2>
                  </div>
                  ))}
                  
                </div>

                <!-- Trending Section -->
                <div class="col-lg-4">

                  <div class="trending">
                    <h3>Trending</h3>
                    <ul class="trending-post">
                      {trend.slice(7, 12).map((post, ind) => (
                        <li>
                          <a href={post.href}>
                            <span class="number">{ind+1}</span>
                            <h3>{post.title}</h3>
                            <span class="author">Marcy</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                </div> <!-- End Trending Section -->
              </div>
            </div>

          </div> <!-- End .row -->
        </div>

      </div>

    </section><!-- /Trending Category Section -->

    <!-- Culture Category Section -->
    <section id="culture-category" class="culture-category section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <div class="section-title-container d-flex align-items-center justify-content-between">
          <h2>Culture</h2>
          <p><a href="categories.html">See All Culture</a></p>
        </div>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row">
          <div class="col-md-9">

            <div class="d-lg-flex post-entry">
              {culture[0] && 
                <a href={culture[0].href} class="me-4 thumbnail mb-4 mb-lg-0 d-inline-block">
                  <BlogImg src={culture[0].img} alt="photo of post" c="img-fluid" />
                </a>
                <div>
                  <div class="post-meta"><span class="date">{culture[0].cate}</span> <span class="mx-1">•</span> <span>{culture[0].date}</span></div>
                  <h3><a href={culture[0].href}>{culture[0].title}</a></h3>
                  <p>{culture[0].preview}</p>
                  <div class="d-flex align-items-center author">
                    <div class="photo"><Image src={avi2} alt="photo of post" class="img-fluid" /></div>
                    <div class="name">
                      <h3 class="m-0 p-0">Marcy</h3>
                    </div>
                  </div>
                </div>
              }
            </div>

            <div class="row">
              <div class="col-lg-4">
                <div class="post-list border-bottom">
                  {culture[1] && 
                    <a href={culture[1].href}><BlogImg src={culture[1].img} alt="photo" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{culture[1].cate}</span> <span class="mx-1">•</span> <span>{culture[1].date}</span></div>
                    <h2 class="mb-2"><a href={culture[1].href}>{culture[1].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                    <p class="mb-4 d-block">{culture[1].preview}</p>
                  }
                </div>

                <div class="post-list">
                  {culture[2] &&
                    <div class="post-meta"><span class="date">{culture[2].cate}</span> <span class="mx-1">•</span> <span>{culture[2].date}</span></div>
                    <h2 class="mb-2"><a href={culture[2].href}>{culture[2].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                  }
                </div>
              </div>
              <div class="col-lg-8">
                <div class="post-list">
                  {culture[3] &&
                    <a href={culture[3].href}><BlogImg src={culture[3].img} height="571" width="900" alt="photo" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{culture[3].cate}</span> <span class="mx-1">•</span> <span>{culture[3].date}</span></div>
                    <h2 class="mb-2"><a href="blog-details.html">{culture[3].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                    <p class="mb-4 d-block">{culture[3].preview}</p>
                  
                  }
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            {culture.slice(4, 10).map(post => (
              <div class="post-list border-bottom">
                <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                <h2 class="mb-2"><a href={post.href}>{post.title}</a></h2>
                <span class="author mb-3 d-block">Marcy</span>
              </div>

            ))}
          </div>
        </div>

      </div>

    </section><!-- /Culture Category Section -->

    <!-- Fashion Category Section -->
    <section id="business-category" class="business-category section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <div class="section-title-container d-flex align-items-center justify-content-between">
          <h2>Fashion</h2>
          <p><a href="categories.html">See All Fashion</a></p>
        </div>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row">
          <div class="col-md-9 order-md-2">

            <div class="d-lg-flex post-entry">
              {culture[0] && 
                <a href={culture[0].href} class="me-4 thumbnail d-inline-block mb-4 mb-lg-0">
                  <BlogImg src={culture[0].img} alt="photo" c="img-fluid" />
                </a>
                <div>
                  <div class="post-meta"><span class="date">Business</span> <span class="mx-1">•</span> <span>{culture[0].date}</span></div>
                  <h3><a href={culture[0].href}>{culture[0].title}</a></h3>
                  <p>{culture[0].preview}</p>
                  <div class="d-flex align-items-center author">
                    <div class="photo"><Image src={avi3} alt="author" class="img-fluid" /></div>
                    <div class="name">
                      <h3 class="m-0 p-0">Marcy</h3>
                    </div>
                  </div>
                </div>
              }
            </div>

             <div class="row">
              <div class="col-lg-4">
                <div class="post-list border-bottom">
                  {culture[1] && 
                    <a href={culture[1].href}><BlogImg src={culture[1].img} alt="photo" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{culture[1].cate}</span> <span class="mx-1">•</span> <span>{culture[1].date}</span></div>
                    <h2 class="mb-2"><a href={culture[1].href}>{culture[1].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                    <p class="mb-4 d-block">{culture[1].preview}</p>
                  }
                </div>

                <div class="post-list">
                  {culture[2] &&
                    <div class="post-meta"><span class="date">{culture[2].cate}</span> <span class="mx-1">•</span> <span>{culture[2].date}</span></div>
                    <h2 class="mb-2"><a href={culture[2].href}>{culture[2].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                  }
                </div>
              </div>
              <div class="col-lg-8">
                <div class="post-list">
                  {culture[3] &&
                    <a href={culture[3].href}><BlogImg src={culture[3].img} height="571" width="900" alt="photo" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{culture[3].cate}</span> <span class="mx-1">•</span> <span>{culture[3].date}</span></div>
                    <h2 class="mb-2"><a href="blog-details.html">{culture[3].title}</a></h2>
                    <span class="author mb-3 d-block">Marcy</span>
                    <p class="mb-4 d-block">{culture[3].preview}</p>
                  }
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            {culture.slice(4, 10).map(post => (
              <div class="post-list border-bottom">
                <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                <h2 class="mb-2"><a href={post.href}>{post.title}</a></h2>
                <span class="author mb-3 d-block">Marcy</span>
              </div>

            ))}
          </div>
        </div>

      </div>

    </section><!-- /Fashion Category Section -->

    <!-- Lifestyle Category Section -->
    <section id="lifestyle-category" class="lifestyle-category section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <div class="section-title-container d-flex align-items-center justify-content-between">
          <h2>Lifestyle</h2>
          <p><a href="categories.html">See All Lifestyle</a></p>
        </div>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-5">
          <div class="col-lg-4">
            <div class="post-list lg">
              {culture[0] && 
                <a href={culture[0].href}><BlogImg src={culture[0].img} alt="picture" c="img-fluid" /></a>
                <div class="post-meta"><span class="date">Lifestyle</span> <span class="mx-1">•</span> <span>{culture[0].date}</span></div>
                <h2><a href={culture[0].href}>{culture[0].title}</a></h2>
                <p class="mb-4 d-block">{culture[0].preview}</p>

                <div class="d-flex align-items-center author">
                  <div class="photo"><Image src={avi4} alt="author" class="img-fluid" /></div>
                  <div class="name">
                    <h3 class="m-0 p-0">Marcy</h3>
                  </div>
                </div>
              
              }
            </div>
            {culture.slice(1, 3).map(post => (
              <div class="post-list border-bottom">
                <div class="post-meta"><span class="date">Lifestyle</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                <h2 class="mb-2"><a href={post.href}>{post.title}</a></h2>
                <span class="author mb-3 d-block">Marcy</span>
              </div>

            ))}

          </div>

          <div class="col-lg-8">
            <div class="row g-5">
              <div class="col-lg-4 border-start custom-border">
                {trend.slice(1, 4).map(post => (
                  <div class="post-list">
                    <a href={post.href}><BlogImg src={post.img} alt="info about Post" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                    <h2><a href={post.href}>{post.title}</a></h2>
                  </div>
                  ))}
              </div>
              <div class="col-lg-4 border-start custom-border">
                {trend.slice(4, 7).map(post => (
                  <div class="post-list">
                    <a href={post.href}><BlogImg src={post.img} alt="info about Post" c="img-fluid" /></a>
                    <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                    <h2><a href={post.href}>{post.title}</a></h2>
                  </div>
                  ))}
              </div>
              <div class="col-lg-4">

                {culture.slice(4, 10).map(post => (
              <div class="post-list border-bottom">
                <div class="post-meta"><span class="date">{post.cate}</span> <span class="mx-1">•</span> <span>{post.date}</span></div>
                <h2 class="mb-2"><a href={post.href}>{post.title}</a></h2>
                <span class="author mb-3 d-block">Marcy</span>
              </div>

            ))}

              </div>
            </div>
          </div>

        </div>

      </div>

    </section><!-- /Lifestyle Category Section -->
</MainLayout>
